---
import 'ren10/components/composites/ren-toolbar/ren-toolbar.css';

/**
 * Toolbar — generated from RenDS composites/ren-toolbar.
 * Contract: ren10/components/composites/ren-toolbar/component.md
 * Registry key: toolbar
 */
export interface Props {
  class?: string;
  [attribute: string]: unknown;
}

const { class: className, ...rest } = Astro.props;
---

<div class:list={['ren-toolbar', className]} {...rest}><slot /></div>

<script>
  import { initToolbar } from 'ren10/components/composites/ren-toolbar/ren-toolbar.js';
  document.querySelectorAll('div').forEach((element) => initToolbar(element));
</script>
