{
  "name": "@ren10/astro",
  "version": "0.13.0",
  "description": "Official Astro integration and generated Light DOM components for RenDS.",
  "license": "MIT",
  "author": "Ren",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rensoconese/ren10.git",
    "directory": "packages/astro"
  },
  "homepage": "https://github.com/Rensoconese/ren10#readme",
  "bugs": "https://github.com/Rensoconese/ren10/issues",
  "type": "module",
  "exports": {
    ".": "./integration.js",
