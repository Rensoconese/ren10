{
  "name": "ren10",
  "version": "0.9.4",
  "description": "RenDS — A vanilla, accessible, atomic design system. No framework required.",
  "author": "Ren",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rensoconese/ren10.git"
  },
  "homepage": "https://github.com/Rensoconese/ren10#readme",
  "type": "module",
  "main": "index.css",
  "bin": {
    "ren10": "cli/index.js"
  },
  "files": [
    "index.css",
    "ren-design.md",
    "AGENTS.md",
    "CLAUDE.md",
    ".cursorrules",
    ".windsurfrules",
    "tokens/",
    "base/",
    "components/",
    "docs/",
    "examples/",
    "site/",
    "templates/",
    "create/",
    "evals/README.md",
    "knowledge/",
    "skills/",
    "utils/",
    "cli/",
    "themes/appearance.css",
    "themes/theme-generator.js",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "import": "./index.css"
    },
    "./components/*": {
      "import": "./components/*"
    },
    "./tokens/*": {
      "import": "./tokens/*"
    },
    "./base/*": {
      "import": "./base/*"
    },
    "./knowledge/*": "./knowledge/*",
    "./themes/appearance.css": "./themes/appearance.css",
    "./themes/theme-generator.js": {
      "import": "./themes/theme-generator.js"
    },
    "./utils": {
      "import": "./utils/index.js"
    }
  },
  "sideEffects": [
    "*.css",
    "./components/**/*.js"
  ],
  "scripts": {
    "lint:css": "stylelint \"components/**/*.css\" \"base/**/*.css\" \"tokens/**/*.css\"",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "lint": "npm run lint:css && npm run lint:tokens",
    "test": "npm run test:all",
    "test:all": "npm run test:a11y && npm run test:components && npm run test:visual -- --project=\"Desktop Light\" && npm run test:theme && npm run test:evals && npm run test:exports && npm run test:knowledge-package && npm run smoke:cli-copy",
    "test:a11y": "playwright test --config tests/a11y/playwright.config.cjs",
    "test:visual": "playwright test --config tests/visual/playwright.config.cjs",
    "test:components": "playwright test --config tests/components/playwright.config.cjs",
    "test:theme": "node themes/theme-generator.test.js",
    "test:evals": "node evals/run-eval.mjs --all",
    "test:exports": "node scripts/verify-package-exports.mjs",
    "test:knowledge-package": "npm run knowledge:check",
    "smoke:cli-copy": "node scripts/smoke-cli-copy.mjs",
    "agent:smoke": "node scripts/smoke-agent-cli.mjs",
    "agent:skill:check": "node scripts/check-agent-skill.mjs",
    "agent:skill:pack": "node scripts/pack-agent-skill.mjs",
    "agent:manifest": "node cli/index.js manifest --json",
    "agent:doctor": "node cli/index.js doctor",
    "agent:check": "npm run agent:smoke && npm run agent:skill:check && node cli/index.js doctor && npm run test:evals && npm run knowledge:check",
    "knowledge:build": "node scripts/build-knowledge-graph.mjs && node scripts/build-knowledge-bundle.mjs",
    "knowledge:check": "node scripts/check-knowledge-graph.mjs && node scripts/check-knowledge-bundle.mjs",
    "knowledge:query": "node scripts/query-knowledge-graph.mjs"
  },
  "keywords": [
    "design-system",
    "css",
    "web-components",
    "accessible",
    "vanilla",
    "a11y",
    "tokens"
  ],
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "axe-core": "^4.11.3",
    "axe-playwright": "^2.2.2",
    "stylelint": "^17.11.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
