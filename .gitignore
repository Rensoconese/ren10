# Dependencies
node_modules/
# Note: package-lock.json IS committed — needed by `npm ci` in CI.
# Ignore the alternative lockfiles to prevent accidental cross-tool commits.
yarn.lock
pnpm-lock.yaml

# Build artifacts
dist/
build/
.cache/
.ren-knowledge/

# Environment
.env
.env.local
.env.*.local

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
.nyc_output/
test-results/
tests/**/test-results/
tests/**/playwright-report/

# Visual baselines: commit only the CI-primary OS (linux). Local runs on
# macOS/Windows generate -darwin.png / -windows.png that would otherwise
# bloat the repo and never get used by CI.
tests/**/visual.spec.cjs-snapshots/*-darwin.png
tests/**/visual.spec.cjs-snapshots/*-windows.png

# Scratch / debug files (leading underscore convention)
_*.cjs
_*.js

# Temporary files
*.tmp
*.temp
.turbo/

# OS files
.DS_Store
.windows-build-tools
